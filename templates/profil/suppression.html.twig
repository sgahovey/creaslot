{#
 # Page de confirmation forte de la suppression (anonymisation) de son compte (US-12.3).
 #
 # Deux états : soit l'utilisateur a des engagements à venir (message d'invitation à les
 # solder, formulaire masqué), soit le formulaire de confirmation irréversible s'affiche.
 # Variables : formSuppression (SuppressionCompteType), aDesEngagements (bool).
 #}
{% extends 'base.html.twig' %}

{% form_theme formSuppression 'bootstrap_5_layout.html.twig' %}

{% block title %}Supprimer mon compte{% endblock %}

{% block body %}
<div class="container py-4 py-md-5" style="max-width: 720px;">

    <h1 class="h3 d-flex align-items-center gap-2 mb-4 text-danger"
        style="font-weight: var(--cs-fw-bold);">
        <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
        Supprimer mon compte
    </h1>

    {% if aDesEngagements %}
        {# ── Blocage : engagements à venir à solder d'abord ──────────────────── #}
        <div class="alert alert-warning" role="alert">
            <p class="mb-2 fw-semibold">Suppression impossible pour le moment.</p>
            <p class="mb-2">
                Vous avez encore des rendez-vous ou des créneaux à venir. Pour préserver
                les engagements pris, veuillez d'abord les annuler ; vous pourrez ensuite
                supprimer votre compte.
            </p>
            <div class="d-flex flex-wrap gap-2 mt-3">
                {% if is_granted('ROLE_AUDITEUR') %}
                    <a href="{{ path('app_mes_reservations') }}" class="btn btn-outline-secondary btn-sm">
                        Voir mes réservations
                    </a>
                {% endif %}
                {% if is_granted('ROLE_PERSONNEL') %}
                    <a href="{{ path('app_creneau_liste') }}" class="btn btn-outline-secondary btn-sm">
                        Voir mes créneaux
                    </a>
                {% endif %}
            </div>
        </div>

        <a href="{{ path('app_mon_profil') }}" class="btn btn-link px-0">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Retour à mon profil
        </a>
    {% else %}
        {# ── Confirmation irréversible ───────────────────────────────────────── #}
        <div class="alert alert-danger" role="alert">
            <p class="mb-2 fw-semibold">Cette action est définitive et irréversible.</p>
            <ul class="mb-0">
                <li>Vos nom, prénom et adresse email seront anonymisés.</li>
                <li>Vous ne pourrez plus vous connecter à ce compte.</li>
                <li>Vos rendez-vous et créneaux passés sont conservés de façon anonyme
                    (intégrité de l'historique).</li>
            </ul>
        </div>

        <section class="card border border-danger shadow-sm"
                 style="border-radius: var(--cs-radius-lg);"
                 aria-labelledby="cs-suppression-titre">
            <div class="card-body p-3 p-md-4">
                <h2 id="cs-suppression-titre" class="h5 mb-3 text-danger"
                    style="font-weight: var(--cs-fw-semibold);">
                    Confirmer la suppression
                </h2>

                {{ form_start(formSuppression, { action: path('app_mon_profil_suppression_confirmer'), attr: { novalidate: 'novalidate' } }) }}
                    {{ form_errors(formSuppression) }}
                    {{ form_row(formSuppression.confirmation) }}

                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <button type="submit" class="btn btn-danger d-inline-flex align-items-center gap-1">
                            <i class="bi bi-trash3" aria-hidden="true"></i>
                            Supprimer définitivement mon compte
                        </button>
                        <a href="{{ path('app_mon_profil') }}" class="btn btn-outline-secondary">
                            Annuler
                        </a>
                    </div>
                {{ form_end(formSuppression) }}
            </div>
        </section>
    {% endif %}

</div>
{% endblock %}
