---
config:
  theme: base
  themeVariables:
    primaryColor: '#DCE7F5'
    primaryBorderColor: '#1F4E79'
    primaryTextColor: '#1E1E1E'
    lineColor: '#1F4E79'
    clusterBkg: '#FFFFFF'
    clusterBorder: '#1F4E79'
---
flowchart TB

    PR["Pull request vers develop, preprod ou main"]

    subgraph QUALITE["Workflow d integration : ci.yml"]
        CS["Style<br/>PHP-CS-Fixer<br/>fix --dry-run --diff"]
        STAN["Analyse statique<br/>PHPStan niveau 8<br/>SANS baseline"]
        TESTS["Tests<br/>PHPUnit + couverture<br/>service MySQL 8 reel<br/>migrations + fixtures<br/><br/>derniere etape du job :<br/>analyse SonarCloud"]
        AUDIT["Audit de securite<br/>composer audit --locked<br/>--no-dev BLOQUANT<br/>deps de developpement : informatif"]
    end

    GATE{"PROTECTION DE BRANCHE : ruleset<br/>les 4 controles exiges AU VERT<br/>BLOQUANT"}

    REFUS["Merge IMPOSSIBLE<br/>tant qu un controle est rouge"]

    MERGE["Merge par pull request<br/>en squash uniquement"]

    DEVELOP["Fusion sur develop<br/>AUCUNE image construite"]

    PROMO["Fusion sur preprod ou main<br/>declenche la promotion"]

    PR --> CS
    PR --> STAN
    PR --> TESTS
    PR --> AUDIT

    CS --> GATE
    STAN --> GATE
    TESTS --> GATE
    AUDIT --> GATE

    GATE -->|"un controle rouge"| REFUS
    GATE ==>|"les 4 controles verts"| MERGE

    MERGE --> DEVELOP
    MERGE ==> PROMO

    classDef entree fill:#f1f3f5,stroke:#868e96,stroke-width:1px,color:#212529
    classDef qualite fill:#a5d8ff,stroke:#1971c2,stroke-width:1px,color:#212529
    classDef bloquant fill:#ffd8a8,stroke:#e8590c,stroke-width:3px,color:#212529
    classDef echec fill:#ffc9c9,stroke:#e03131,stroke-width:2px,color:#212529

    class PR entree
    class CS,STAN,TESTS,AUDIT qualite
    class GATE bloquant
    class REFUS echec
    class MERGE,DEVELOP,PROMO entree
