@startuml
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Sans
skinparam defaultFontSize 13
skinparam component {
  BorderColor #1F4E79
  BackgroundColor #DCE7F5
  FontColor #1E1E1E
}
skinparam database {
  BorderColor #1F4E79
  BackgroundColor #F1F3F5
  FontColor #1E1E1E
}
skinparam actor {
  BorderColor #1F4E79
  FontColor #1E1E1E
}
skinparam package {
  BorderColor #1F4E79
  BackgroundColor #FFFFFF
  FontColor #1E1E1E
}
skinparam ArrowColor #1F4E79
skinparam note {
  BorderColor #1F4E79
  BackgroundColor #F1F3F5
  FontColor #1E1E1E
}
left to right direction

actor "Auditeur" as AUD
actor "Personnel" as PER
actor "Super-administrateur" as ADM

package "Système de prise de rendez-vous" {
  component "Portail web\nespaces cloisonnés par rôle" as PORTAIL
  component "Traitement métier\nrègles de réservation\net d'habilitation" as METIER
}

database "Réservoir\nde données" as DONNEES
component "Service d'envoi\nde messages" as MSG

AUD --> PORTAIL : réserve
PER --> PORTAIL : publie ses créneaux
ADM --> PORTAIL : administre

PORTAIL --> METIER
METIER --> DONNEES
METIER ..> MSG : notifie
MSG ..> AUD : courriel
MSG ..> PER : courriel

legend bottom
  Trait plein : échange synchrone, réalisé dans le fil de la demande qui le déclenche
  Trait pointillé : échange différé, dont l'échec ne remet pas en cause l'opération d'origine
endlegend
@enduml
