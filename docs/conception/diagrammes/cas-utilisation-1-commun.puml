@startuml cas-utilisation-1-commun
' =====================================================================
' CreaSlot — Cas d'utilisation 1/4 : acces public et espace commun
'
' Fidele au code : chaque cas d'usage correspond a une route reellement
' declaree dans src/Controller/ et protegee par access_control
' (PUBLIC_ACCESS) ou par #[IsGranted('IS_AUTHENTICATED_FULLY')].
'
' Sources : SecurityController, ResetPasswordController, LegalController,
'           MonProfilController, NotificationListeController, ExportController.
' =====================================================================

left to right direction
skinparam shadowing false
skinparam actorStyle awesome
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam usecase {
  BorderColor #1F4E79
  BackgroundColor #DCE7F5
  FontColor #1E1E1E
}
skinparam actor {
  BorderColor #1F4E79
  FontColor #1E1E1E
}
skinparam participant {
  BorderColor #1F4E79
  BackgroundColor #DCE7F5
  FontColor #1E1E1E
}
skinparam sequence {
  ArrowColor #1F4E79
  LifeLineBorderColor #1F4E79
  GroupBorderColor #1F4E79
}
skinparam package {
  BorderColor #1F4E79
  FontColor #1E1E1E
}
skinparam note {
  BorderColor #1F4E79
  BackgroundColor #F1F3F5
  FontColor #1E1E1E
}

title Cas d'utilisation — Accès public et espace commun

actor "Visiteur" as VISITEUR
actor "Utilisateur authentifié" as UTILISATEUR

rectangle CreaSlot {

    package "Accès public" {
        usecase "Se connecter"                              as UC_CONNEXION
        usecase "S'inscrire"                                as UC_INSCRIPTION
        usecase "Redemander un lien\nde confirmation"        as UC_CONFIRM_RENVOI
        usecase "Demander une réinitialisation\ndu mot de passe" as UC_MDP_DEMANDE
        usecase "Réinitialiser son mot de passe"            as UC_MDP_RESET
        usecase "Consulter les pages légales"               as UC_LEGAL
    }

    package "Commun (authentifié)" {
        usecase "Se déconnecter"                            as UC_DECONNEXION
        usecase "Consulter son profil"                      as UC_PROFIL
        usecase "Modifier ses informations"                 as UC_PROFIL_INFOS
        usecase "Changer son mot de passe"                  as UC_PROFIL_MDP
        usecase "Consulter ses notifications"               as UC_NOTIFICATIONS
        usecase "Consulter ses données\npersonnelles (RGPD)" as UC_DONNEES
        usecase "Exporter ses données\npersonnelles (RGPD)"  as UC_DONNEES_EXPORT
        usecase "Supprimer son compte\n(anonymisation, RGPD art. 17)" as UC_SUPPRESSION
    }
}

' Associations — Visiteur (routes PUBLIC_ACCESS)
VISITEUR -- UC_CONNEXION
VISITEUR -- UC_INSCRIPTION
VISITEUR -- UC_CONFIRM_RENVOI
VISITEUR -- UC_MDP_DEMANDE
VISITEUR -- UC_MDP_RESET
VISITEUR -- UC_LEGAL

' Associations — Utilisateur authentifié (IS_AUTHENTICATED_FULLY)
UTILISATEUR -- UC_DECONNEXION
UTILISATEUR -- UC_PROFIL
UTILISATEUR -- UC_PROFIL_INFOS
UTILISATEUR -- UC_PROFIL_MDP
UTILISATEUR -- UC_NOTIFICATIONS
UTILISATEUR -- UC_DONNEES
UTILISATEUR -- UC_DONNEES_EXPORT
UTILISATEUR -- UC_SUPPRESSION

' La réinitialisation du mot de passe envoie un E-MAIL
' (ResetPasswordController -> NotificationService::envoyer via Mailer),
' PAS une notification in-app : aucune relation <<include>> vers un cas
' "notification". Les notifications in-app ne concernent que le cycle
' réservation/créneau (cf. TypeNotification : 5 types seulement).

note top of UTILISATEUR
  Acteur abstrait : représente tout compte
  authentifié, quel que soit son rôle
  (IS_AUTHENTICATED_FULLY).
end note

legend right
  | **Élément** | **Signification** |
  | Acteur | Rôle qui interagit avec le système |
  | Cas d'utilisation | Fonctionnalité offerte par le système |
  | Association (--) | L'acteur déclenche le cas d'utilisation |
  | Héritage (flèche creuse) | L'acteur fils hérite des cas du parent |
endlegend

@enduml
